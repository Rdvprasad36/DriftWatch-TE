# DriftWatch-TE environment variables
# Copy to .env and fill in values. NEVER commit .env.

# Provider API keys (one per hosted model)
GROQ_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=

# Hugging Face token for dataset upload
HF_TOKEN=

# Optional: local model endpoint
LOCAL_MODEL_URL=http://localhost:11434

